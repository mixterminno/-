<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Una flor amarilla para ti</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;1,500;1,600&display=swap" rel="stylesheet">
<style>
  :root {
    --night: #0c0f24;
    --dusk: #2b1d55;
    --honey: #ffc61a;
    --pollen: #ffe680;
    --ink: #fff3d1;
    --ink-soft: rgba(255, 243, 209, 0.72);
    color-scheme: dark;
    box-sizing: border-box;
    padding-top: env(safe-area-inset-top, 0px);
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }
  html { scroll-padding-top: env(safe-area-inset-top, 0px); }
  html, body { height: 100%; margin: 0; }
  body {
    background-color: var(--night);
    background-image: radial-gradient(ellipse 75% 55% at 50% 34%, #43307f 0%, #1d1946 45%, var(--night) 82%);
    color: var(--ink);
    font-family: 'Cormorant Garamond', Georgia, 'Times New Roman', serif;
    overflow: hidden;
  }

  /* Halo y rayos de luz detrás de la flor (JS los coloca sobre la flor) */
  .fx {
    position: fixed; left: 50%; top: 38%;
    width: 0; height: 0;
    pointer-events: none;
    --s: min(150vw, 150vh);
    opacity: 0.25;
  }
  .aura, .rays {
    position: absolute;
    width: var(--s); height: var(--s);
    left: calc(var(--s) / -2); top: calc(var(--s) / -2);
    border-radius: 50%;
  }
  .aura {
    background: radial-gradient(circle, rgba(255, 198, 26, 0.34) 0%, rgba(255, 170, 30, 0.12) 20%, rgba(255, 170, 30, 0) 44%);
  }
  .rays {
    background: repeating-conic-gradient(rgba(255, 226, 120, 0.13) 0deg 5deg, rgba(255, 226, 120, 0) 5deg 16deg);
    -webkit-mask-image: radial-gradient(circle, #000 0%, rgba(0, 0, 0, 0) 60%);
    mask-image: radial-gradient(circle, #000 0%, rgba(0, 0, 0, 0) 60%);
    animation: spin 140s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  #c {
    position: fixed; inset: 0;
    width: 100%; height: 100%;
    display: block;
    touch-action: none;
    cursor: grab;
  }
  #c.drag { cursor: grabbing; }

  .msg {
    position: fixed; left: 0; right: 0; bottom: 0;
    padding: 4.5rem 1.5rem calc(1.1rem + env(safe-area-inset-bottom, 0px));
    background: linear-gradient(to top, var(--night) 60%, rgba(12, 15, 36, 0));
    text-align: center;
    pointer-events: none;
  }
  .msg-inner { max-width: 33rem; margin: 0 auto; }
  .msg p {
    margin: 0 0 0.7em;
    font-style: italic;
    font-weight: 500;
    font-size: clamp(1.08rem, 3.7vw, 1.55rem);
    line-height: 1.4;
    opacity: 0;
    transform: translateY(6px);
  }
  .msg.on p {
    opacity: 1;
    transform: none;
    transition: opacity 1.4s ease, transform 1.4s ease;
  }
  .msg.on p:nth-child(2) { transition-delay: 1.1s; }
  .msg.on p:nth-child(3) { transition-delay: 2.2s; }
  .msg.on p:nth-child(4) { transition-delay: 3.5s; }
  .msg.on p:nth-child(5) { transition-delay: 4.6s; }
  .msg p.epi {
    font-size: clamp(1rem, 3.3vw, 1.3rem);
    color: var(--pollen);
    margin-top: 0.9em;
  }
  .msg p.epi .src {
    display: block;
    font-size: 0.85em;
    color: var(--ink-soft);
    margin-top: 0.15em;
  }
  .msg p.sign {
    font-size: clamp(1rem, 3.2vw, 1.25rem);
    color: var(--pollen);
    margin-top: 0.2em;
  }
  .controls {
    display: flex; gap: 1.25rem; justify-content: center; align-items: baseline;
    font-size: 1rem; color: var(--ink-soft);
    pointer-events: auto;
    margin-top: 0.4rem;
  }
  .controls button {
    font: inherit; color: var(--pollen);
    background: none; border: 0; padding: 0.3rem 0.1rem;
    text-decoration: underline; text-underline-offset: 0.22em;
    cursor: pointer;
  }
  .controls button:focus-visible { outline: 2px solid var(--honey); outline-offset: 3px; border-radius: 3px; }

  @media (prefers-reduced-motion: reduce) {
    .msg p, .msg.on p { transition: none !important; transform: none; }
    .rays { animation: none; }
  }
</style>
</head>
<body>
<div class="fx" id="fx" aria-hidden="true"><div class="aura"></div><div class="rays"></div></div>
<canvas id="c" aria-label="Flor amarilla en 3D. Arrastra para girarla."></canvas>

<div class="msg" id="msg">
  <div class="msg-inner" id="msgText"></div>
  <div class="controls">
    <span>Arrastra para girarla</span>
    <button id="toggle" type="button">Cerrar la flor</button>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
(function () {
  // ---- Texto: edítalo aquí ------------------------------------------------
  const MENSAJE = [
    "Si me pidieran un color para nombrarte, diría amarillo: el de la luz que entra por la mañana sin pedir permiso.",
    "Contigo aprendí que florecer no es un esfuerzo, es quedarse cerca de quien te hace sol.",
    "Esta flor es solo un pretexto. Lo que quiero decirte es que, contigo, todos los días se abren."
  ];
  const EPIGRAFE = "“La luz de tus ojos ha coloreado mi oscuridad.”";
  const EPIGRAFE_FUENTE = "Rosalía de Castro"; // déjalo vacío ("") si prefieres no citar autora
  const FIRMA = ""; // p. ej. "Para ti" o el nombre de quien escribe
  // -------------------------------------------------------------------------

  const msgEl = document.getElementById('msg');
  const msgText = document.getElementById('msgText');
  MENSAJE.forEach(t => { const p = document.createElement('p'); p.textContent = t; msgText.appendChild(p); });
  if (EPIGRAFE) {
    const p = document.createElement('p'); p.className = 'epi';
    p.appendChild(document.createTextNode(EPIGRAFE));
    if (EPIGRAFE_FUENTE) { const sp = document.createElement('span'); sp.className = 'src'; sp.textContent = EPIGRAFE_FUENTE; p.appendChild(sp); }
    msgText.appendChild(p);
  }
  if (FIRMA) { const p = document.createElement('p'); p.className = 'sign'; p.textContent = FIRMA; msgText.appendChild(p); }

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let revealed = false;
  function reveal() { if (revealed) return; revealed = true; msgEl.classList.add('on'); }

  if (typeof THREE === 'undefined') { reveal(); return; }

  const canvas = document.getElementById('c');
  const fx = document.getElementById('fx');
  let renderer;
  try {
    renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
  } catch (e) { reveal(); return; }
  const PR = Math.min(window.devicePixelRatio || 1, 2);
  renderer.setPixelRatio(PR);
  renderer.setClearColor(0x000000, 0);

  const scene = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(40, 1, 0.1, 100);

  scene.add(new THREE.HemisphereLight(0xfff1c2, 0x3a2a70, 0.55));
  const key = new THREE.DirectionalLight(0xffe2a0, 0.8); key.position.set(3, 5, 6); scene.add(key);
  const rim = new THREE.DirectionalLight(0x9d8cff, 0.45); rim.position.set(-5, 2, -4); scene.add(rim);
  const warm = new THREE.PointLight(0xffb800, 0.7, 7); warm.position.set(0, 1.2, 2.2); scene.add(warm);

  const clamp = (x, a, b) => Math.min(b, Math.max(a, x));
  const smooth = t => t * t * t * (t * (t * 6 - 15) + 10);
  let s = 11; const rnd = () => { s = (s * 16807) % 2147483647; return (s - 1) / 2147483646; };

  // ---- Pétalo: forma, geometría y nervaduras -----------------------------
  function petalPoint(o, u, v) {
    const prof = Math.pow(Math.max(0, Math.sin(Math.PI * Math.pow(u, 0.85))), 0.7);
    const w = o.W * (prof + 0.1 * (1 - u) * (1 - u));
    const z = o.curl * o.L * u * u
            + o.cross * w * v * v * 0.5
            + (o.frill || 0) * v * v * Math.sin(u * 10) * w * 0.35;
    return [v * w * 0.5, u * o.L, z];
  }
  function petalGeometry(o) {
    const SV = 10, SU = 18;
    const g = new THREE.PlaneGeometry(1, 1, SV, SU);
    const pos = g.attributes.position;
    const col = new Float32Array(pos.count * 3);
    const cB = new THREE.Color(o.base), cM = new THREE.Color(o.mid), cT = new THREE.Color(o.tip);
    const c = new THREE.Color();
    for (let i = 0; i < pos.count; i++) {
      const u = pos.getY(i) + 0.5;
      const v = pos.getX(i) * 2;
      const p = petalPoint(o, u, v);
      pos.setXYZ(i, p[0], p[1], p[2]);
      if (u < 0.45) c.copy(cB).lerp(cM, u / 0.45); else c.copy(cM).lerp(cT, (u - 0.45) / 0.55);
      c.lerp(cT, Math.pow(Math.abs(v), 3) * 0.25);
      col[i * 3] = c.r; col[i * 3 + 1] = c.g; col[i * 3 + 2] = c.b;
    }
    g.setAttribute('color', new THREE.BufferAttribute(col, 3));
    g.computeVertexNormals();
    return g;
  }
  function veinTexture() {
    const c = document.createElement('canvas'); c.width = 128; c.height = 256;
    const x = c.getContext('2d');
    x.fillStyle = '#ffffff'; x.fillRect(0, 0, 128, 256);
    x.lineCap = 'round';
    for (let i = -5; i <= 5; i++) {
      x.strokeStyle = i === 0 ? 'rgba(200,120,0,0.28)' : 'rgba(210,140,10,0.16)';
      x.lineWidth = i === 0 ? 2.2 : 1.2;
      x.beginPath(); x.moveTo(64, 256);
      x.quadraticCurveTo(64 + i * 4, 150, 64 + i * 11, 30 + Math.abs(i) * 6);
      x.stroke();
    }
    const t = new THREE.CanvasTexture(c); t.anisotropy = 4; return t;
  }
  const petalMat = new THREE.MeshStandardMaterial({
    vertexColors: true, map: veinTexture(), side: THREE.DoubleSide, roughness: 0.5, metalness: 0,
    emissive: 0x3a2400, emissiveIntensity: 0.4
  });
  const leafMat = new THREE.MeshStandardMaterial({
    vertexColors: true, side: THREE.DoubleSide, roughness: 0.6, metalness: 0
  });
  const dewMat = new THREE.MeshPhongMaterial({
    color: 0xfff2c8, specular: 0xffffff, shininess: 160, transparent: true, opacity: 0.65
  });
  const dewGeo = new THREE.SphereGeometry(1, 12, 10);

  // ---- Planta -------------------------------------------------------------
  const plant = new THREE.Group();
  scene.add(plant);

  const head = new THREE.Group();
  head.position.set(0, 0, 0.3);
  head.rotation.x = 0.6;
  plant.add(head);

  // Tallo
  const stemCurve = new THREE.CatmullRomCurve3([
    new THREE.Vector3(0, -3.7, -0.5),
    new THREE.Vector3(0.1, -2.7, -0.72),
    new THREE.Vector3(0, -1.7, -0.62),
    new THREE.Vector3(0, -0.907, -0.32),
    new THREE.Vector3(0, -0.165, 0.187)
  ]);
  plant.add(new THREE.Mesh(
    new THREE.TubeGeometry(stemCurve, 60, 0.06, 10, false),
    new THREE.MeshStandardMaterial({ color: 0x2f7a4f, roughness: 0.7 })
  ));

  // Hojas
  const leafGeo = petalGeometry({ L: 1.5, W: 0.62, curl: 0.45, cross: 0.5, frill: 0.3, base: '#1f5a3b', mid: '#2f8a52', tip: '#54b374' });
  [[0.38, 0.9, 0.85], [0.6, Math.PI + 0.7, 0.95]].forEach(([t, ang, tilt]) => {
    const leaf = new THREE.Mesh(leafGeo, leafMat);
    leaf.position.copy(stemCurve.getPointAt(t));
    leaf.rotation.order = 'YXZ';
    leaf.rotation.y = ang; leaf.rotation.x = tilt;
    plant.add(leaf);
  });

  // Sépalos
  const sepalGeo = petalGeometry({ L: 0.55, W: 0.3, curl: 0.2, cross: 0.3, base: '#2a6b45', mid: '#3d8f5a', tip: '#5fb37a' });
  for (let k = 0; k < 6; k++) {
    const m = new THREE.Mesh(sepalGeo, leafMat);
    m.rotation.order = 'YXZ';
    m.rotation.y = (k / 6) * Math.PI * 2 + 0.3;
    m.rotation.x = 2.35;
    m.position.y = -0.02;
    head.add(m);
  }

  // Pétalos: cuatro anillos alrededor del disco central, con rocío
  const rings = [
    { n: 14, L: 1.75, W: 0.72, open: 1.36, closed: -0.26, curl: 0.16,  cross: 0.35, frill: 0.5, off: 0.0, base: 0.42 },
    { n: 14, L: 1.55, W: 0.68, open: 1.10, closed: -0.24, curl: 0.08,  cross: 0.40, frill: 0.4, off: 0.5, base: 0.40 },
    { n: 12, L: 1.30, W: 0.62, open: 0.84, closed: -0.22, curl: -0.02, cross: 0.40, frill: 0.3, off: 0.0, base: 0.37 },
    { n: 10, L: 1.05, W: 0.54, open: 0.58, closed: -0.20, curl: -0.16, cross: 0.40, frill: 0.2, off: 0.5, base: 0.33 }
  ];
  const petals = [];
  rings.forEach((r, ri) => {
    const f = ri / (rings.length - 1);
    const base = new THREE.Color('#d98200').lerp(new THREE.Color('#f2a100'), f);
    const mid = new THREE.Color('#ffc21a').lerp(new THREE.Color('#ffcf33'), f);
    const tip = new THREE.Color('#ffe680').lerp(new THREE.Color('#ffd84d'), f);
    const geo = petalGeometry({
      L: r.L, W: r.W, curl: r.curl, cross: r.cross, frill: r.frill,
      base: '#' + base.getHexString(), mid: '#' + mid.getHexString(), tip: '#' + tip.getHexString()
    });
    for (let k = 0; k < r.n; k++) {
      const m = new THREE.Mesh(geo, petalMat);
      const ang = ((k + r.off) / r.n) * Math.PI * 2 + (rnd() - 0.5) * 0.08;
      m.rotation.order = 'YXZ';
      m.rotation.y = ang;
      m.rotation.z = (rnd() - 0.5) * 0.2;
      m.position.set(Math.sin(ang) * r.base, ri * 0.03, Math.cos(ang) * r.base);
      const sc = 0.92 + rnd() * 0.16;
      m.scale.set(sc, sc, sc);
      head.add(m);

      // gotas de rocío en los pétalos exteriores
      if (ri < 2 && rnd() < 0.5) {
        const cnt = 1 + (rnd() < 0.4 ? 1 : 0);
        for (let d = 0; d < cnt; d++) {
          const p = petalPoint(r, 0.45 + rnd() * 0.35, (rnd() - 0.5) * 0.7);
          const drop = new THREE.Mesh(dewGeo, dewMat);
          const rad = 0.02 + rnd() * 0.025;
          drop.scale.set(rad, rad, rad);
          drop.position.set(p[0], p[1], p[2] - 0.03);
          m.add(drop);
        }
      }
      petals.push({
        mesh: m, open: r.open, closed: r.closed,
        jx: (rnd() - 0.5) * 0.16,
        delay: ri * 0.09 + rnd() * 0.04
      });
    }
  });

  // Centro: cúpula, semillas en espiral áurea y cuentas de polen brillante
  const hub = new THREE.Mesh(
    new THREE.SphereGeometry(0.46, 24, 12, 0, Math.PI * 2, 0, Math.PI / 2),
    new THREE.MeshStandardMaterial({ color: 0xb35f00, roughness: 0.7 })
  );
  hub.scale.y = 0.5; hub.position.y = 0.02;
  head.add(hub);

  const SEEDS = 420;
  const seeds = new THREE.InstancedMesh(
    new THREE.SphereGeometry(0.035, 8, 6),
    new THREE.MeshStandardMaterial({ roughness: 0.5 }),
    SEEDS
  );
  const dummy = new THREE.Object3D();
  const cIn = new THREE.Color('#7a3d00'), cOut = new THREE.Color('#f5a800'), cc = new THREE.Color();
  for (let i = 0; i < SEEDS; i++) {
    const r = 0.42 * Math.sqrt((i + 0.5) / SEEDS);
    const a = i * 2.39996323;
    const h = 0.23 * Math.sqrt(Math.max(0, 1 - (r / 0.46) * (r / 0.46))) + 0.04;
    dummy.position.set(Math.cos(a) * r, 0.02 + h, Math.sin(a) * r);
    const k = 0.8 + (r / 0.42) * 0.5;
    dummy.scale.set(k, k, k);
    dummy.updateMatrix();
    seeds.setMatrixAt(i, dummy.matrix);
    cc.copy(cIn).lerp(cOut, Math.pow(r / 0.42, 1.3));
    seeds.setColorAt(i, cc);
  }
  seeds.instanceMatrix.needsUpdate = true;
  seeds.instanceColor.needsUpdate = true;
  head.add(seeds);

  const BEADS = 70;
  const beads = new THREE.InstancedMesh(
    new THREE.SphereGeometry(0.02, 8, 6),
    new THREE.MeshStandardMaterial({ color: 0xffe9a0, emissive: 0xffb800, emissiveIntensity: 0.9, roughness: 0.3 }),
    BEADS
  );
  for (let i = 0; i < BEADS; i++) {
    const r = 0.38 * Math.sqrt(rnd()), a = rnd() * Math.PI * 2;
    const h = 0.23 * Math.sqrt(Math.max(0, 1 - (r / 0.46) * (r / 0.46))) + 0.075;
    dummy.position.set(Math.cos(a) * r, 0.02 + h, Math.sin(a) * r);
    dummy.scale.set(1, 1, 1);
    dummy.updateMatrix();
    beads.setMatrixAt(i, dummy.matrix);
  }
  beads.instanceMatrix.needsUpdate = true;
  head.add(beads);

  // ---- Chispas de luz (brillan y se apagan) ------------------------------
  function dotTexture() {
    const c = document.createElement('canvas'); c.width = c.height = 64;
    const x = c.getContext('2d');
    const g = x.createRadialGradient(32, 32, 0, 32, 32, 32);
    g.addColorStop(0, 'rgba(255,240,170,1)');
    g.addColorStop(0.4, 'rgba(255,220,100,0.5)');
    g.addColorStop(1, 'rgba(255,200,60,0)');
    x.fillStyle = g; x.fillRect(0, 0, 64, 64);
    return new THREE.CanvasTexture(c);
  }
  const P = 160;
  const pPos = new Float32Array(P * 3), pPhase = new Float32Array(P), pSize = new Float32Array(P), pSpeed = new Float32Array(P);
  for (let i = 0; i < P; i++) {
    const a = rnd() * Math.PI * 2, r = 1.2 + rnd() * 3.2;
    pPos[i * 3] = Math.cos(a) * r;
    pPos[i * 3 + 1] = -3 + rnd() * 7;
    pPos[i * 3 + 2] = Math.sin(a) * r - 0.5;
    pPhase[i] = rnd() * 6.28;
    pSize[i] = 0.08 + rnd() * rnd() * 0.32;
    pSpeed[i] = 0.08 + rnd() * 0.16;
  }
  const pGeo = new THREE.BufferGeometry();
  pGeo.setAttribute('position', new THREE.BufferAttribute(pPos, 3));
  pGeo.setAttribute('aPhase', new THREE.BufferAttribute(pPhase, 1));
  pGeo.setAttribute('aSize', new THREE.BufferAttribute(pSize, 1));
  const sparkMat = new THREE.ShaderMaterial({
    uniforms: { uTime: { value: 0 }, uScale: { value: 600 }, uMap: { value: dotTexture() } },
    vertexShader: [
      'attribute float aPhase; attribute float aSize;',
      'uniform float uTime; uniform float uScale; varying float vA;',
      'void main(){',
      '  vec4 mv = modelViewMatrix * vec4(position, 1.0);',
      '  gl_PointSize = aSize * uScale / (-mv.z);',
      '  vA = 0.3 + 0.7 * (0.5 + 0.5 * sin(uTime * 1.7 + aPhase));',
      '  gl_Position = projectionMatrix * mv;',
      '}'
    ].join('\n'),
    fragmentShader: [
      'uniform sampler2D uMap; varying float vA;',
      'void main(){ vec4 t = texture2D(uMap, gl_PointCoord); gl_FragColor = vec4(t.rgb, t.a * vA); }'
    ].join('\n'),
    transparent: true, depthWrite: false, blending: THREE.AdditiveBlending
  });
  scene.add(new THREE.Points(pGeo, sparkMat));

  // ---- Pétalos sueltos que caen despacio ---------------------------------
  const fallGeo = petalGeometry({ L: 0.5, W: 0.34, curl: 0.3, cross: 0.8, frill: 0, base: '#f0a800', mid: '#ffc61a', tip: '#ffe27a' });
  fallGeo.translate(0, -0.25, 0);
  const fallers = [];
  function respawn(f) {
    f.m.position.set((rnd() - 0.5) * 2.4, 1.2 + rnd() * 1.2, (rnd() - 0.5) * 1.6 + 0.4);
    f.x0 = f.m.position.x; f.ph = rnd() * 6.28; f.vy = 0.22 + rnd() * 0.18;
    f.sp = [(rnd() - 0.5) * 1.2, (rnd() - 0.5) * 1.2, (rnd() - 0.5) * 1.2];
  }
  for (let i = 0; i < 8; i++) {
    const m = new THREE.Mesh(fallGeo, petalMat);
    m.visible = false; m.scale.setScalar(0.7 + rnd() * 0.5);
    scene.add(m);
    const f = { m, wait: i * 2.4, active: false };
    respawn(f); fallers.push(f);
  }

  // ---- Floración ----------------------------------------------------------
  let bloom = reduceMotion ? 1 : 0;
  let target = reduceMotion ? 1 : 0;
  function applyBloom(t) {
    for (const p of petals) {
      const local = smooth(clamp((t - p.delay) / 0.68, 0, 1));
      p.mesh.rotation.x = p.closed + (p.open - p.closed) * local + p.jx * local;
    }
  }
  applyBloom(bloom);
  if (reduceMotion) reveal(); else setTimeout(() => { target = 1; }, 700);

  const toggle = document.getElementById('toggle');
  function setTarget(v) {
    target = v;
    toggle.textContent = v ? 'Cerrar la flor' : 'Abrir la flor';
    if (reduceMotion) { bloom = v; applyBloom(bloom); }
  }
  toggle.addEventListener('click', () => setTarget(target ? 0 : 1));

  // ---- Interacción: arrastrar, tocar, rueda -------------------------------
  let dragging = false, lastX = 0, lastY = 0, downX = 0, downY = 0, downT = 0;
  let vel = reduceMotion ? 0 : 0.15;
  const autoSpeed = reduceMotion ? 0 : 0.15;
  let zoom = 1;
  canvas.addEventListener('pointerdown', e => {
    dragging = true; lastX = downX = e.clientX; lastY = downY = e.clientY; downT = performance.now();
    canvas.classList.add('drag'); canvas.setPointerCapture(e.pointerId);
  });
  canvas.addEventListener('pointermove', e => {
    if (!dragging) return;
    const dx = e.clientX - lastX, dy = e.clientY - lastY;
    lastX = e.clientX; lastY = e.clientY;
    plant.rotation.y += dx * 0.008;
    plant.rotation.x = clamp(plant.rotation.x + dy * 0.005, -0.3, 0.6);
    vel = dx * 0.008 * 60;
  });
  function endDrag(e) {
    if (!dragging) return;
    dragging = false; canvas.classList.remove('drag');
    const moved = Math.hypot(e.clientX - downX, e.clientY - downY);
    if (moved < 6 && performance.now() - downT < 350) setTarget(target ? 0 : 1);
  }
  canvas.addEventListener('pointerup', endDrag);
  canvas.addEventListener('pointercancel', () => { dragging = false; canvas.classList.remove('drag'); });
  canvas.addEventListener('wheel', e => {
    e.preventDefault();
    zoom = clamp(zoom * (1 + e.deltaY * 0.001), 0.65, 1.4);
  }, { passive: false });

  // ---- Tamaño y bucle -----------------------------------------------------
  let baseDist = 8;
  function resize() {
    const w = window.innerWidth, h = window.innerHeight;
    renderer.setSize(w, h, false);
    camera.aspect = w / h;
    baseDist = Math.max(7.4, 5.2 / (0.728 * camera.aspect));
    camera.updateProjectionMatrix();
    sparkMat.uniforms.uScale.value = h * PR / (2 * Math.tan(20 * Math.PI / 180));
  }
  window.addEventListener('resize', resize);
  resize();

  const tv = new THREE.Vector3();
  function updateFx() {
    head.getWorldPosition(tv);
    tv.project(camera);
    fx.style.left = ((tv.x * 0.5 + 0.5) * window.innerWidth).toFixed(1) + 'px';
    fx.style.top = ((-tv.y * 0.5 + 0.5) * window.innerHeight).toFixed(1) + 'px';
    fx.style.opacity = (0.25 + 0.75 * bloom).toFixed(3);
  }

  const clock = new THREE.Clock();
  let time = 0;
  function frame() {
    const dt = Math.min(clock.getDelta(), 0.05);
    time += dt;
    sparkMat.uniforms.uTime.value = time;

    if (!reduceMotion) {
      const step = 0.4 * dt;
      if (bloom < target) bloom = Math.min(target, bloom + step);
      else if (bloom > target) bloom = Math.max(target, bloom - step);
      applyBloom(bloom);
      if (bloom > 0.85) reveal();

      if (!dragging) {
        vel += (autoSpeed - vel) * (1 - Math.exp(-dt * 1.5));
        plant.rotation.y += vel * dt;
        plant.rotation.z = Math.sin(time * 0.7) * 0.018;
      }
      warm.intensity = 0.7 + Math.sin(time * 1.4) * 0.12;

      const a = pPos;
      for (let i = 0; i < P; i++) {
        a[i * 3 + 1] += pSpeed[i] * dt;
        a[i * 3] += Math.sin(time * 0.6 + pPhase[i]) * 0.0025;
        if (a[i * 3 + 1] > 4) a[i * 3 + 1] = -3;
      }
      pGeo.attributes.position.needsUpdate = true;

      for (const f of fallers) {
        if (!f.active) {
          if (bloom > 0.95) { f.wait -= dt; if (f.wait <= 0) { f.active = true; f.m.visible = true; } }
          continue;
        }
        f.m.position.y -= f.vy * dt;
        f.m.position.x = f.x0 + Math.sin(time * 0.8 + f.ph) * 0.35;
        f.m.rotation.x += f.sp[0] * dt; f.m.rotation.y += f.sp[1] * dt; f.m.rotation.z += f.sp[2] * dt;
        if (f.m.position.y < -3.4) respawn(f);
      }
    }

    camera.position.set(0, 0.5, baseDist * zoom);
    camera.lookAt(0, -1.2, 0);
    renderer.render(scene, camera);
    updateFx();
    requestAnimationFrame(frame);
  }
  frame();
})();
</script>
